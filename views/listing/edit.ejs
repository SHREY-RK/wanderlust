<% layout("/layouts/boilerplate.ejs") %>
  <link rel="stylesheet" href="/css/addStyle.css">
  <div class="form-container">
    <h2>edit old Listing</h2>
    <p class="subtitle">Enter the old property details below.</p>
    
    <form method="POST" action="/listings/<%= data._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
      
      <div class="form-group">
        <label for="title">Property Title</label>
        <input type="text" id="title"   placeholder= "<%= data.title %>" readonly class="form-control">
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="Escape to this charming beachfront cottage..." class="form-control" required><%= data.description %></textarea>
        <div class="invalid-feedback">please enter a description</div>
      </div>

      <div class="form-row">
        <div class="form-group half-width">
          <label for="price">Price ($)</label>
          <input type="number" id="price" name="price" placeholder="1500" min="0" value=<%= data.price %> class="form-control">
        </div>
      <div class="form-group half-width">
          <label for="image">Upload New Image</label>
          <input type="file" id="image" name="image" class="form-control">
      </div>
      </div>

      <div class="form-row">
        <div class="form-group half-width">
          <label for="location">Location (City)</label>
          <input type="text" id="location"  placeholder="<%= data.location %>" readonly class="form-control">
        </div>
        
        <div class="form-group half-width">
          <label for="country">Country</label>
          <input type="text" id="country" placeholder="<%= data.country %>" readonly class="form-control">
        </div>
      </div>
      <p style="margin: 0; font-weight:lighter;">old image</p>
      <div
        class="img"
        style="
        border: 1px solid black;
        height: 200px;
        background-image: url('<%= data.image.url %>');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      ">
      </div>
      
<button type="submit" class="submit-btn">Save Listing</button>
      </div>

    </form>
</div> 