<% layout("/layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="/css/viewStyle.css">
<link rel="stylesheet" href="/css/rating.css">

    <main class="property-page">

        <header class="property-header">
            <h1 class="property-title">
                <%= data.title %>
            </h1>
            <h5>Owned by <i>
                    <%= data.owner.username %>
                </i>
            </h5>
            
            <div class="property-location">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>
                    <%= data.location %>, <%= data.country %>
                </span>
            </div>
        </header>

        <div class="property-hero">


            <% if (data.country !="United States" ) { %>
                <div class="card-badge" style="display: none;">Superhost</div>
            <% } else { %>
                <div class="card-badge">Superhost</div>
            <% } %>
            <img src="<%=data.image.url %>">
        </div>

        <div class="property-grid">

            <div class="property-details">
                <div class="host-info">
                    <h2>Entire villa hosted by Superhost</h2>
                    <p>8 guests · 4 bedrooms · 5 beds · 4.5 baths</p>
                </div>

                <hr class="divider">

                <div class="description-section">
                    <h3>About this space</h3>
                    <p>
                        Experience luxury in the middle of the desert in this opulent oasis in Dubai. Enjoy modern
                        amenities mixed with traditional architecture.
                    </p>
                    <p>
                        Wake up to panoramic views of the dunes, relax in your private temperature-controlled infinity
                        pool, and enjoy evenings under the stars. Perfect for families or groups looking for an
                        unforgettable escape.
                    </p>
                </div>
            </div>

            <aside class="booking-sidebar">
                <div class="booking-widget">
                    <div class="widget-header">
                        <div class="widget-price">
                            <strong>$<%= data.price.toLocaleString("en-US") %></strong> <span>night</span>
                        </div>
                    </div>

                    <button class="book-btn" onclick="window.location.href='checkout.html'">Reserve</button>

                    <p class="charge-note">You won't be charged yet</p>
                </div>
            </aside>

        </div>
        <% if (currUser && currUser._id.equals(data.owner._id)) { %>

            <form method="post" action="/listings/<%= data._id %>/delete?_method=DELETE" class="btns">
                <button type="submit" class="btn btn-danger delete">Delete</button>
                <div class="btn edit" >
                    <a href="/listings/<%= data._id %>/edit">Edit</a>
                </div>
            </form>
        <% } %>
        <% if (currUser) { %>
            <hr>
            <div class="review mb-3 mt-3">
                <h4>Leave a review</h4>
                <form method="post" action="/listings/<%= data._id%>/reviews" novalidate class="needs-validation">
                    <!-- <div class="mb-3 mt-3">
                        
                        <input type="range" id="rating" min="1" max="5" step="1" name="review[rating]" class="form-range">
                    </div> -->
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <legend>First rating:</legend>
                        <!-- <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." /> -->
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" checked />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea type="text" id="comment" name="review[comment]" class="form-control" rows="4" required></textarea>
                        <div class="invalid-feedback">enter a valid comment</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            </div>
        <% } %>
        <hr>
        <div class="show-review mt-3 mb-3">
            <% if(data.reviews.length>0){ %> 
                <h4>All review</h4>
            <% } %>
            <div class="row">

                <% for (review of data.reviews) { %>
                    <div class="card mt-2 ms-3 col-5">
                        <div class="card-body">
                            <h5 class="card-title">@<%= review.author.username %></h5>        
                            <p class="starability-result" data-rating=<%= review.rating %>></p>
                            <p class="card-text"><%= review.comment %></p>         
                            <form method="post" action="/listings/<%=data._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-dark btn-sm"><i class="fa-solid fa-trash"></i>delete</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
        <h3>Where you'll be</h3>
        <div
            id="map"
            data-location="<%= data.location %>"
            data-country="<%= data.country %>"
            data-lon="<%= data.geometry.coordinates[0] %>"
            data-lat="<%= data.geometry.coordinates[1] %>">
        </div>
    </main>
